#!/bin/sh
# The flashteams command, for Claude Code. Claude Code puts this plugin's
# bin folder on the PATH of its Bash tool, and this hands every argument to
# the flashteams command that Flash Console keeps in its own folder. Flash
# Console names that folder in FLASH_CONSOLE_BIN in every shell it starts.
#
# On Windows, where Claude Code's Bash tool is Git Bash, the command is
# flashteams.exe, kept in %LOCALAPPDATA%\Flash Console\bin. Windows sets OS
# to Windows_NT for every program. Inside WSL in a Flash Console pane, it is
# the same flashteams.exe, in the folder FLASH_CONSOLE_BIN names as Linux
# sees it, which WSL runs on Windows.
#
# The flashteams command only talks to Flash Console on this computer;
# this file holds no token and makes no connection of its own.

if [ "${OS-}" = Windows_NT ]; then
  # Windows writes its paths with backslashes, and Git Bash takes slashes.
  rest="${FLASH_CONSOLE_BIN:-${LOCALAPPDATA:-}/Flash Console/bin}/flashteams.exe"
  bin=
  while :; do
    case $rest in
    *\\*)
      bin="$bin${rest%%\\*}/"
      rest=${rest#*\\}
      ;;
    *)
      bin="$bin$rest"
      break
      ;;
    esac
  done
  # Git Bash rewrites an argument that looks like a Unix path, such as
  # /src/main.rs or --path=/src, into a Windows one when it starts a Windows
  # program like flashteams.exe. Both settings turn that off, so every
  # argument arrives as written: the first for Git for Windows, the second
  # for MSYS2.
  MSYS_NO_PATHCONV=1
  MSYS2_ARG_CONV_EXCL='*'
  export MSYS_NO_PATHCONV MSYS2_ARG_CONV_EXCL
elif [ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]; then
  # Only a full path, so a relative folder never runs a program from the
  # agent's working folder. WSL started anywhere else has none.
  case ${FLASH_CONSOLE_BIN:-} in
  /*) bin="$FLASH_CONSOLE_BIN/flashteams.exe" ;;
  *) bin= ;;
  esac
else
  bin="${FLASH_CONSOLE_BIN:-${HOME:-}/Library/Application Support/Flash Console/bin}/flashteams"
fi

# A FLASH_CONSOLE_BIN naming this folder would start this file again, and
# again. FLASHTEAMS_SHIM marks the second time round.
if [ -n "${FLASHTEAMS_SHIM:-}" ] || [ -z "$bin" ] || [ ! -f "$bin" ] || [ ! -x "$bin" ]; then
  echo "Flash Console is not running or is too old to provide the flashteams command." >&2
  exit 3
fi
FLASHTEAMS_SHIM=1
export FLASHTEAMS_SHIM
exec "$bin" "$@"
