#!/bin/sh
# Copies the files the plugins share from shared/ into each plugin folder.
# Edit them in shared/, then run this. script/check fails when a copy is
# out of date.
#
# The flashteams skill is the same for both agents, except that Claude
# Code's copy adds allowed-tools, a field Codex does not read. It lets the
# skill run, without asking each time, the flashteams commands that only
# read: tools, help, and the tools below. Every command that changes
# FlashTeams, such as update_task, complete_project or ask_flashbrain, goes
# through Claude Code's usual permission prompt, as the same tool did over
# MCP, and so does a tool missing from this list. Only Claude Code puts a
# plugin's bin folder on its PATH, so only it gets the shim.
set -eu
cd "$(dirname "$0")/.."

# FlashTeams tools that only read, or only choose what this session works
# on (connect_workspace, connect_program). get_flashbrain_answer is left out
# because it can restart a paused FlashBrain run, and documentation because
# the same tool also edits documents.
allowed=""
for tool in \
  tools help \
  list_my_projects connect_workspace find_tasks load_task load_project search get_events \
  list_programs connect_program program_documents list_products \
  code_map query_codebase read_source read_docs resolve_code_name \
  search_recipes learn_recipe run_recipe get_findings find_experts \
  list_pending_approvals; do
  allowed="${allowed:+$allowed, }Bash(flashteams $tool:*)"
done

for plugin in plugins/claude/flashteams plugins/codex/flashteams; do
  mkdir -p "$plugin/hooks" "$plugin/skills/flashteams"
  cp shared/hooks/flashteams-hook.pl shared/hooks/flashteams-hook.sh "$plugin/hooks/"
  cp shared/skills/flashteams/SKILL.md "$plugin/skills/flashteams/"
done

mkdir -p plugins/claude/flashteams/bin
cp shared/bin/flashteams plugins/claude/flashteams/bin/
chmod 755 plugins/claude/flashteams/bin/flashteams
ALLOWED_TOOLS="$allowed" perl -pi -e 'print "allowed-tools: $ENV{ALLOWED_TOOLS}\n" if $_ eq "---\n" && ++$fences == 2' \
  plugins/claude/flashteams/skills/flashteams/SKILL.md

for plugin in plugins/claude/flashteams-mcp plugins/codex/flashteams-mcp; do
  mkdir -p "$plugin/skills/flashteams-next-task"
  cp shared/skills/flashteams-next-task/SKILL.md "$plugin/skills/flashteams-next-task/"
done
echo "Copied shared/ into every plugin."
