#!/bin/sh
# Runs every check. The same script runs on your computer and in GitHub
# Actions, and it exits non-zero when anything fails.
#
#   script/check
#
# Needs Perl (any 5.20 or later) and ShellCheck. Without ShellCheck it skips
# that step on your computer, but not in CI. When the claude command is
# installed it also runs Claude Code's own plugin validator.
set -eu
cd "$(dirname "$0")/.."

step() { printf '\n==> %s\n' "$*"; }

step "Perl compiles the hook and the tests"
perl -c shared/hooks/flashteams-hook.pl
perl -c test/hook.t
perl -c test/manifests.t
perl -c test/bin.t

step "ShellCheck"
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck shared/hooks/flashteams-hook.sh shared/bin/flashteams script/check script/sync
  # Each hook command in both hooks.json files, and the guard script it
  # hands to sh -c, checked as an sh script of its own.
  commands=$(mktemp -d)
  trap 'rm -rf "$commands"' EXIT
  perl -MJSON::PP -e '
    my ($dir, @files) = @ARGV;
    my ($n, %seen) = (0);
    for my $file (@files) {
      open(my $fh, "<", $file) or die "$file: $!";
      my $config = decode_json(do { local $/; <$fh> });
      for my $handler (map { @{ $_->{hooks} } } map { @$_ } values %{ $config->{hooks} }) {
        my ($guard) = $handler->{command} =~ /\Ash -c \x27([^\x27]*)\x27 sh /;
        for my $script (grep { defined && !$seen{$_}++ } $handler->{command}, $guard) {
          open(my $out, ">", "$dir/" . ++$n . ".sh") or die "$dir: $!";
          print $out "#!/bin/sh\n$script\n";
        }
      }
    }' "$commands" plugins/claude/flashteams/hooks/hooks.json plugins/codex/flashteams/hooks/hooks.json
  shellcheck "$commands"/*.sh
  echo "ShellCheck found nothing"
elif [ -n "${CI:-}" ]; then
  echo "ShellCheck is required in CI" >&2
  exit 1
else
  echo "ShellCheck is not installed, so this step was skipped (CI runs it)"
fi

step "Claude Code plugin validator"
if command -v claude >/dev/null 2>&1; then
  claude plugin validate --strict .
  claude plugin validate --strict plugins/claude/flashteams
  claude plugin validate --strict plugins/claude/flashteams-mcp
else
  echo "The claude command is not installed, so this step was skipped"
fi

step "Tests"
prove test/

printf '\nAll checks passed.\n'
